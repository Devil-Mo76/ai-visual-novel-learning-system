# 复制本文件为 .env 后按需修改。不配置也能跑（默认 SQLite + 无 Key → 样例剧本）。

# —— 数据库 ——
# 留空 = 本地 SQLite（答辩演示最省事，零配置）
# 接真实 PostgreSQL 时取消注释并填写：
# DATABASE_URL=postgresql://用户名:密码@localhost:5432/learning_system

# —— CORS 白名单（开发期留 *；答辩部署可收窄，生产建议同源+明确白名单）——
# 多个域名用逗号分隔，如：http://localhost:8080,https://learn.example.com
# CORS_ORIGINS=*

# —— 网络部署（A）：生产建议 Nginx 反向代理统一入口（见 deploy/nginx.conf），
#    前端静态由 Nginx 提供、/api 转发到后端，走 HTTPS/TLS，CORS 通常可不再放开。
# —— 安全（B）：登录/注册限流、生成/讲师限流已内置（进程内令牌桶）——

# —— 默认模型名（设置界面也可改，这里仅作兜底）——
# DEFAULT_MODEL=deepseek-chat

# ════════════════════════════════════════════════════════
#  模型路由层（云端-边缘混合降级）
#  短任务（判题/评估/讲师）→ 本地 Qwen2.5-1.5B 优先（离线、低延迟）
#  长任务（生成剧本）      → 云端 DeepSeek 优先（质量更高）
#  网络不可用/超时         → 自动降级，恢复后看门狗自动回切
# ════════════════════════════════════════════════════════

# 路由策略：auto（默认 短→本地/长→云端）| local（强制本地）| cloud（强制云端）
# 也可在「设置」界面实时切换（落库 settings.llm_engine）
LLM_ENGINE=auto

# 本地 GGUF 模型路径（默认：项目根/models/qwen2.5-1.5b-instruct-q4_k_m.gguf）
# LOCAL_MODEL_PATH=E:/大学/本科毕业论文/frontend/models/qwen2.5-1.5b-instruct-q4_k_m.gguf
# 本地推理资源（CPU 推理时生效；有 GPU 可把 LOCAL_GPU_LAYERS 调大）
LOCAL_NCTX=8192
LOCAL_NTHREADS=0          # 0 = 自动取 min(8, CPU 核数)
LOCAL_GPU_LAYERS=0        # 0 = 纯 CPU；有 CUDA 可设 20~35 卸载到显存
LOCAL_MAX_TOKENS=768      # 短任务本地输出预算上限（防 1.5B 在 CPU 上跑太久）
LOCAL_TEMPERATURE=0.2

# 云端熔断与自适应（断网 → 熔断降级到本地，冷却后回切）
ROUTE_FAIL_THRESHOLD=2    # 连续失败几次触发熔断
ROUTE_COOLDOWN_SEC=60     # 熔断冷却时间（秒）
ROUTE_PROBE_TIMEOUT=6.0   # 云端链路探测超时（秒）
ROUTE_WATCHDOG=1          # 后台看门狗：周期探测云端，恢复即回切（1 开 / 0 关）
ROUTE_WATCHDOG_INTERVAL=60
# LONG_LOCAL_FALLBACK=0   # 生成剧本失败是否降级到本地（默认关：1.5B 质量不稳，交给 P1 样例剧本兜底）
